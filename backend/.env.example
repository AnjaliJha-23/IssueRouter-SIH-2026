# Environment Configuration for IssueRouter Backend (Azure App Service / Production)

# Optional external LLM inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Database persistence & auto-seeding
DATABASE_URL=sqlite:///./issueRouter.db
SQLITE_DB_PATH=./issueRouter.db
AUTO_SEED_ON_START=true
UNIVERSITIES_CSV_PATH=../docs/Jharkhand universities list with domains updated.csv

# Security & CORS configuration (Required for Azure deployment)
# Comma-separated allowed origins (add your Vercel frontend URL here)
CORS_ORIGINS=https://issue-router.vercel.app,http://localhost:5173,http://localhost:3000
JWT_SECRET=your_secure_random_jwt_secret_key_here
ENVIRONMENT=production

# Server port configuration
PORT=8000
