# ==============================================================================
# IssueRouter Environment Configuration Template
# ==============================================================================

# Database Connectivity
# For Azure PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>.postgres.database.azure.com:5432/<dbname>?sslmode=require
# If omitted, defaults to local SQLite: sqlite:///backend/issueRouter.db
DATABASE_URL=sqlite:///issueRouter.db

# Security & Authentication
# Strong secret key for signing JWT tokens in production
JWT_SECRET=your_production_jwt_secret_key_here
SECRET_KEY=your_production_jwt_secret_key_here

# Networking & CORS
# Comma-separated list of allowed origins (e.g. your Vercel deployment URL and custom domains)
ALLOWED_ORIGINS=https://your-issuerouter-app.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ORIGINS=https://your-issuerouter-app.vercel.app,http://localhost:5173,http://localhost:3000

# Summarization & External LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Decision Model (TypeSafe JEV) - domain/subdomain + urgency/severity decisions
# Get an API key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_MODEL=jev-latest
# jev | transformers | keyword
#   jev          TypeSafe System One (default; falls back to keyword on failure)
#   transformers local facebook/bart-large-mnli (~1.6 GB RAM; offline/benchmark)
#   keyword      deterministic lexicon (no network, no model weights)
CLASSIFIER_BACKEND=jev
# Per-request timeout (seconds) and retries on 429/529 for the Jev API.
JEV_TIMEOUT=20
JEV_MAX_RETRIES=2
# Text-primary / image-secondary cascade. Experimental JEV "danger zone" feature:
# sends citizen photos (PII/face risk) to the TypeSafe API. Keep false unless enabled.
JEV_ENABLE_IMAGES=false
# JEV 1.14+ bounding-box localization of the issue in a photo (most experimental).
JEV_ENABLE_BOX=false

# NLP Pipeline Models (Preserved)
# Local zero-shot model, used only when CLASSIFIER_BACKEND=transformers.
CLASSIFICATION_MODEL=facebook/bart-large-mnli

# Model Cache Directories (Persistent mount on Azure App Service)
HF_HOME=/home/site/models/huggingface
TRANSFORMERS_CACHE=/home/site/models/transformers
TORCH_HOME=/home/site/models/torch

# Model Warm-up (Optional: set to true to warm up models during container startup)
WARM_MODELS_ON_STARTUP=false

# Database Seeding Safety Flag (Set to false in production to prevent DB wipe)
ALLOW_DB_WIPE=false
